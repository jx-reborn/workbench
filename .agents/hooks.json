{
  "jx-parity-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "read_file|write_file|edit_file|run_command|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "python ../qa/scripts/pre_tool_parity_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
